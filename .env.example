# Copy this file to .env.local and fill it in. Never commit .env.local.

# Google Gemini API key, used only on the server by app/api/ask.
GEMINI_API_KEY=
# Optional: override the model. Defaults to gemini-flash-latest.
# GEMINI_MODEL=gemini-flash-latest

# Contact form SMTP (app/api/contact). Port 465 uses implicit TLS.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Where contact form enquiries are delivered, comma separated.
CONTACT_TO=
